        "subject": "✦ Welcome to Swarnix — Your store has been approved!",
        "message": "={{ (function() {\n  var ownerName  = $('Parse Decision & Token').first().json.name || 'Store Owner';\n  var storeName  = $('Parse Decision & Token').first().json.storeName || '';\n  var planLabel  = $('Parse Decision & Token').first().json.plan || 'trial';\n  planLabel = planLabel.charAt(0).toUpperCase() + planLabel.slice(1);\n  return '<div style=\"font-family:Georgia,serif;max-width:560px;margin:0 auto;color:#333;\">'\n    + '<div style=\"background:linear-gradient(135deg,#1A3A5C,#2C5F8A);padding:28px;border-radius:8px 8px 0 0;\">'\n    + '<h1 style=\"color:#C9A84C;margin:0;font-size:22px;font-weight:400;\">✦ Welcome to Swarnix!</h1></div>'\n    + '<div style=\"background:#fffdf5;padding:28px;border:1px solid #e8d5a3;border-top:none;\">'\n    + '<p style=\"font-size:15px;\">Dear <strong>' + ownerName + '</strong>,</p>'\n    + '<p style=\"font-size:14px;color:#444;line-height:1.7;margin:16px 0;\">Your jewellery store' + (storeName ? (' <strong>' + storeName + '</strong>') : '') + ' has been <strong style=\"color:#166534;\">approved</strong> on the <strong>' + planLabel + '</strong> plan! You can now log in and start managing your inventory.</p>'\n    + '<div style=\"margin:24px 0;text-align:center;\">'\n    + '<a href=\"https://karat-seven.vercel.app/\" style=\"display:inline-block;background:#1A3A5C;color:#C9A84C;padding:14px 36px;border-radius:8px;text-decoration:none;font-size:14px;font-weight:600;\">Open Swarnix Inventory →</a>'\n    + '</div>'\n    + '<p style=\"font-size:13px;color:#888;\">Questions? Email <a href=\"mailto:nikimodi81@gmail.com\" style=\"color:#1A3A5C;\">nikimodi81@gmail.com</a></p>'\n    + '</div>'\n    + '<div style=\"background:#f9f4e8;padding:14px 28px;border:1px solid #e8d5a3;border-top:none;border-radius:0 0 8px 8px;font-size:12px;color:#999;\">Swarnix Inventory Platform</div></div>';\n})() }}",
        "options": {}
