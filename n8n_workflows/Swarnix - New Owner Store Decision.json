        "message": "={{ '<div style=\"font-family:Georgia,serif;max-width:560px;margin:0 auto;color:#333;\">'\n  + '<div style=\"background:linear-gradient(135deg,#1A3A5C,#2C5F8A);padding:28px;border-radius:8px 8px 0 0;\">'\n  + '<h1 style=\"color:#C9A84C;margin:0;font-size:22px;font-weight:400;\">✦ Swarnix</h1></div>'\n  + '<div style=\"background:#fffdf5;padding:28px;border:1px solid #e8d5a3;border-top:none;\">'\n  + '<p style=\"font-size:15px;\">Dear <strong>' + $json.name + '</strong>,</p>'\n  + '<p style=\"font-size:14px;color:#444;line-height:1.7;margin:16px 0;\">Thank you for signing up' + ($json.storeName ? (' your store <strong>' + $json.storeName + '</strong>') : '') + '. Unfortunately, your store access request has not been approved at this time.</p>'\n  + '<p style=\"font-size:14px;color:#444;line-height:1.7;\">If you believe this is an error or would like to discuss further, please reach out directly:</p>'\n  + '<p style=\"font-size:14px;margin:20px 0;\"><a href=\"mailto:nikimodi81@gmail.com\" style=\"color:#1A3A5C;font-weight:600;\">nikimodi81@gmail.com</a></p>'\n  + '</div>'\n  + '<div style=\"background:#f9f4e8;padding:14px 28px;border:1px solid #e8d5a3;border-top:none;border-radius:0 0 8px 8px;font-size:12px;color:#999;\">Swarnix Inventory Platform</div></div>' }}",
