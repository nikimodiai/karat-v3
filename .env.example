# ── Frontend env vars (Vite — only VITE_* are exposed to browser) ──
# Copy this to .env.local and fill in real values. Never commit .env.local.

# Supabase (PUBLIC anon key — safe in browser; protected by Row Level Security)
VITE_SUPABASE_URL=https://bigmdvjrvqyqzyrijdum.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Cloudinary (PUBLIC — unsigned upload preset; restricted by preset config)
VITE_CLOUDINARY_CLOUD=jewelleryinventory
VITE_CLOUDINARY_PRESET=jewelleryupload
VITE_CLOUDINARY_VIDEO_PRESET=jewelleryvideoupload

# n8n webhook base (PUBLIC URL — webhook endpoints are authenticated server-side)
VITE_N8N_BASE=https://n8n.srv1639765.hstgr.cloud/webhook

# Optional: live gold rate API (default: manual entry by owner)
# VITE_GOLD_RATE_API=https://api.example.com/gold-rate

# Facebook App (for WhatsApp Business Embedded Signup)
# Create at https://developers.facebook.com/apps/ — must be a Business type app
# with "WhatsApp Business" product added and "Embedded Signup" enabled.
VITE_FB_APP_ID=your_facebook_app_id_here

# ────────────────────────────────────────────────────────────────────
# NEVER put service-role keys, OpenAI keys, WhatsApp tokens, or
# Gmail OAuth secrets in this file — they belong in n8n credentials.
